# Contact form (app/api/contact). With Gmail, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Where messages are delivered. Defaults to the email in lib/content.js.
CONTACT_TO=
